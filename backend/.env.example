# Base de données PostgreSQL (remplacez par votre URL Neon)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"
SHADOW_DATABASE_URL="postgresql://username:password@host:port/database_shadow?sslmode=require"

# JWT Secret - Générez une clé forte en production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Port (Railway utilisera process.env.PORT automatiquement)
PORT=3000

# Environnement
NODE_ENV=production

# CORS Origins (ajoutez vos domaines de production)
CORS_ORIGINS="*"
